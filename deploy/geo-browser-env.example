# ===== geo-browser 配置模板 =====
# 使用方式：复制本文件为 geo-browser-env 后按需修改（本机连库时填真实 DB_* 即可）。
# 本文件是公开模板，不要填真实密码。
# 改动在下次启动时生效（启动脚本自动读取 geo-browser-env）。

# 存储：file=本地 json 台账；mysql=写数据库（需配下方 DB_*）
GEO_STORAGE=file

# 产物落盘：debug=截图/页面存档落盘（目录见 GEO_DATA_ROOT）；none=不落盘
GEO_ARTIFACT_MODE=debug

# 数据目录（账号 profile / 代理台账 / 截图 / 信源分析产物都放这里），与项目平级、不进仓库
GEO_DATA_ROOT=../geo-browser-data

# 本机访问端口
PORT=8787

# 用系统 Chrome（本地版开）；容器版关
GEO_USE_SYSTEM_CHROME=1

# 同时打开浏览器的上限
GEO_MAX_BROWSERS=4

# ===== MySQL（仅 GEO_STORAGE=mysql 时需要）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geo
