# ===== geo-browser 配置模板 =====
# 使用方式：复制本文件为 geo-browser-env 后按需修改（本机连库时填真实 DB_* 即可）。
# 本文件是公开模板，不要填真实密码。
# 改动在下次启动时生效（启动脚本自动读取 geo-browser-env）。

# 诊断产物：none=生产态，只产出交付物（Q&A 产品图）与结构化结果，不落盘诊断现场；
#           debug=额外落盘 01~04 诊断连拍 / before·answering·finished.html / network.har / report.html，仅排障时用
GEO_ARTIFACT_MODE=none

# 数据目录（账号 profile / 代理台账 / 截图 / 信源分析产物都放这里），与项目平级、不进仓库
GEO_DATA_ROOT=../geo-browser-data

# 本机访问端口
PORT=8787

# 收录检测：对方服务地址（拉词/回推）。留空则需在页面手填
GEO_PULL_HOST=http://127.0.0.1:8101

# 每日执行时刻（HH:mm）：定时检测前一天的数据，留空=不启用
GEO_PULL_DAILY_AT=10:00

# 往前覆盖的天数：1=昨天，3=前三天（默认 1）
GEO_PULL_DAYS_BACK=1

# 快代理动态代理：按「账号 ↔ IP」绑定取出口 IP（同一账号在 IP 有效期内固定走同一出口；
# IP 到期即解散该 IP 及其全部绑定，账号下次取用时再绑）。留空=不启用（走账号绑定代理/直连）
GEO_DPS_SECRET_ID=
GEO_DPS_SECRET_KEY=
GEO_DPS_USERNAME=
GEO_DPS_PASSWORD=
# 复用阈值（秒）：IP 剩余有效期低于此值不再使用（按到期处理：解散并取新 IP），默认 60
GEO_DPS_MIN_TTL_SEC=60
# 每枚 IP 允许承载的同平台账号数（N）：一个 IP = 5 平台 × N 个账号位。越小越分散（风控更安全）、越费 IP；默认 2
GEO_DPS_ACCOUNTS_PER_IP=2
# 同时持有 IP 数上限（默认 5 = 平台数）：达到上限说明配额/清理逻辑有问题，正常不该出现
GEO_DPS_MAX_IPS=5

# 用系统 Chrome（本地版开）；容器版关
GEO_USE_SYSTEM_CHROME=1


# 页面就绪等待（毫秒）：goto 导航上限 + 豆包发送双道就绪门（打字前等输入区挂载、打字后等按钮启用）
GEO_NAV_TIMEOUT_MS=100000

# 回答等待上限（毫秒）：慢代理下元宝 SSE 流极慢，180s 只能攒半截答案，放宽到 300s
GEO_ANSWER_TIMEOUT_MS=300000


# 账号冷却区间（秒）：账号释放后到下次可被挑选的等待时长，区间内随机取值（也可写单值如 180 固定）
GEO_ACCOUNT_INTERVAL_SEC=120-300

# 动态回退直连熔断（秒）：快代理取 IP 失败回退直连后，该平台动态账号暂停派发的时长
GEO_DYN_FALLBACK_SEC=600

# 调度扫描间隔（秒）：任务池多久扫描一次可执行任务
GEO_SCHEDULER_TICK=10

# 浏览器槽位上限（0=自动取启用平台数）
GEO_MAX_SLOTS=0

# ===== 代理 bypass（选配）=====
# 直连、不走代理的域名（逗号分隔）。2026-10-15 用户定：豆包/字节系 CDN 域已移除，全流量走代理与其他平台一致；
# 仅保留 Google 字体域（各平台通用静态资源）。若要 100% 全代理，把值清空即可
GEO_PROXY_BYPASS="fonts.googleapis.com,fonts.gstatic.com"

# ===== MySQL（必填，本项目仅支持数据库存储）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geo
